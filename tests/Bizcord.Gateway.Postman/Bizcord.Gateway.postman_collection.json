    {
      "name": "GraphQL",
      "description": "The GraphQL endpoint in WorkspaceApi through the gateway (docs/graphql.md). The gateway lets a token through with any GraphQL scope, and WorkspaceApi checks the exact scope per field.",
      "item": [
        {
          "name": "Query a workspace with its channels and members",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with the workspace, its channels and members in one response', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const workspace = pm.response.json().data.workspace;",
                  "    pm.expect(workspace.name).to.eql('postman-upload-test');",
                  "    pm.expect(workspace.channels.map(c => c.name)).to.include('general');",
                  "    pm.expect(workspace.members[0].role).to.eql('ADMIN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/graphql",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query($id: UUID!) { workspace(id: $id) { name channels { name } members { role } } }\",\n  \"variables\": {\n    \"id\": \"{{uploadWorkspaceId}}\"\n  }\n}"
            }
          }
        },
        {
          "name": "Mutation creates a workspace",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the workspace is created', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data.createWorkspace.name).to.eql('postman-graphql-test');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/graphql",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { createWorkspace(name: \\\"postman-graphql-test\\\") { id name } }\",\n  \"variables\": {}\n}"
            }
          }
        },
        {
          "name": "Mutation with only workspace.read is not authorized",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refused by WorkspaceApi, nothing is created', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data).to.be.null;",
                  "    pm.expect(body.errors[0].extensions.code).to.eql('AUTH_NOT_AUTHORIZED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{readOnlyToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/graphql",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { createWorkspace(name: \\\"should-not-be-created\\\") { id } }\",\n  \"variables\": {}\n}"
            }
          }
        },
