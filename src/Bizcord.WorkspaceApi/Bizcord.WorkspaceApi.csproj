<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bizcord.WorkspaceApi</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- HotChocolate's global usings bring in an Error and a Result<T> that clash with the domain's.
         The GraphQL files use HotChocolate explicitly instead. -->
    <HotChocolateImplicitUsings>disable</HotChocolateImplicitUsings>
    <HotChocolateCompositeImplicitUsings>disable</HotChocolateCompositeImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.86" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.7.6" />
    <PackageReference Include="HotChocolate.AspNetCore.Authorization" Version="16.7.6" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <EmbeddedResource Include="Data\Migrations\001_baseline.sql" />
    <EmbeddedResource Include="Data\Migrations\002_constraints.sql" />
    <EmbeddedResource Include="Data\Migrations\003_channel_last_activity.sql" />
    <EmbeddedResource Include="Data\Migrations\004_storage_quota.sql" />
    <EmbeddedResource Include="Data\Migrations\005_workspace_version.sql" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bizcord.MessageClient\Bizcord.MessageClient.csproj" />
    <ProjectReference Include="..\Bizcord.Contracts\Bizcord.Contracts.csproj" />
    <ProjectReference Include="..\Bizcord.Vault\Bizcord.Vault.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

</Project>
