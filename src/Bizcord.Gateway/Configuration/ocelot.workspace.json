{
  "Routes": [
    {
      "Key": "workspaces-read",
      "UpstreamPathTemplate": "/api/v1/workspaces",
      "UpstreamHttpMethod": ["GET"],
      "DownstreamPathTemplate": "/api/v1/workspaces",
      "DownstreamScheme": "http",
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": ["Bearer"],
        "AllowedScopes": ["workspace.read"]
      },
      "Priority": 2,
      "DownstreamHostAndPorts": [
        {
          "Host": "workspace-api",
          "Port": 8080
        }
      ]
    },
    {
      "Key": "workspaces-write",
      "DownstreamHeaderTransform": {
        "Location": "http://workspace-api:8080, {BaseUrl}"
      },
      "UpstreamPathTemplate": "/api/v1/workspaces",
      "UpstreamHttpMethod": ["POST"],
      "DownstreamPathTemplate": "/api/v1/workspaces",
      "DownstreamScheme": "http",
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": ["Bearer"],
        "AllowedScopes": ["workspace.write"]
      },
      "Priority": 2,
      "DownstreamHostAndPorts": [
        {
          "Host": "workspace-api",
          "Port": 8080
        }
      ]
    },
    {
      "Key": "workspace-by-id-write",
      "UpstreamPathTemplate": "/api/v1/workspaces/{id}",
      "UpstreamHttpMethod": ["PUT", "DELETE"],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": ["Bearer"],
        "AllowedScopes": ["workspace.write"]
      },
      "DownstreamPathTemplate": "/api/v1/workspaces/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "workspace-api",
          "Port": 8080
        }
      ]
    },
    {
      "Key": "workspace-by-id-read",
      "UpstreamPathTemplate": "/api/v1/workspaces/{id}",
      "UpstreamHttpMethod": ["GET"],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": ["Bearer"],
        "AllowedScopes": ["workspace.read"]
      },
      "DownstreamPathTemplate": "/api/v1/workspaces/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "workspace-api",
          "Port": 8080
        }
      ]
    },
    {
      "Key": "workspace-channels-read",
      "UpstreamPathTemplate": "/api/v1/workspaces/{workspaceId}/channels",
      "UpstreamHttpMethod": ["GET"],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": ["Bearer"],
        "AllowedScopes": ["channel.read"]
      },
      "Priority": 2,
      "DownstreamPathTemplate": "/api/v1/workspaces/{workspaceId}/channels",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "workspace-api",
          "Port": 8080
        }
      ]
    },
    {
      "Key": "workspace-channels-write",
      "DownstreamHeaderTransform": {
        "Location": "http://workspace-api:8080, {BaseUrl}"
      },
      "UpstreamPathTemplate": "/api/v1/workspaces/{workspaceId}/channels",
      "UpstreamHttpMethod": ["POST"],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": ["Bearer"],
        "AllowedScopes": ["channel.write"]
      },
      "Priority": 2,
      "DownstreamPathTemplate": "/api/v1/workspaces/{workspaceId}/channels",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "workspace-api",
          "Port": 8080
        }
      ]
    },
    {
      "Key": "workspace-graphql",
      "UpstreamPathTemplate": "/graphql",
      "UpstreamHttpMethod": ["POST", "GET"],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": ["Bearer"],
        "AllowedScopes": ["workspace.read", "workspace.write", "channel.write"]
      },
      "DownstreamPathTemplate": "/graphql",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "workspace-api",
          "Port": 8080
        }
      ]
    },
    {
      "Key": "internal-channel-member",
      "UpstreamPathTemplate": "/internal/channels/{channelId}/members/{userId}",
      "UpstreamHttpMethod": ["GET"],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": ["Bearer"]
      },
      "RouteClaimsRequirement": {
        "role": "internal-service"
      },
      "DownstreamPathTemplate": "/internal/channels/{channelId}/members/{userId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "workspace-api",
          "Port": 8080
        }
      ]
    }
  ]
}
